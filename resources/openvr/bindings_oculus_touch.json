{
  "controller_type": "oculus_touch",
  "name": "Vlick VR Keyboard bindings for Oculus Touch Controllers",
  "description": "Left joystick click toggles the overlay; triggers press keys; grips move it; while either grip is moving the keyboard, use the right joystick to adjust distance.",
  "bindings": {
    "/actions/global": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/global/in/toggle_overlay"
            }
          }
        }
      ]
    },
    "/actions/overlay": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/overlay/in/primary"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/overlay/in/primary"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/overlay/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/overlay/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/overlay/in/adjust_distance"
            }
          }
        }
      ],
      "haptics": [
        {
          "path": "/user/hand/left/output/haptic",
          "output": "/actions/overlay/out/haptic"
        },
        {
          "path": "/user/hand/right/output/haptic",
          "output": "/actions/overlay/out/haptic"
        }
      ]
    },
    "/actions/blocker": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/blocker/in/block_scalar" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/blocker/in/block_scalar" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/blocker/in/block_scalar" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/blocker/in/block_scalar" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/blocker/in/block_axis" },
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/blocker/in/block_axis" },
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/blocker/in/block_boolean" },
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/left/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        },
        {
          "path": "/user/hand/right/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": { "output": "/actions/blocker/in/block_boolean" }
          }
        }
      ]
    }
  }
}
